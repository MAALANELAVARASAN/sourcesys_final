# ── AI APIs ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
NOMIC_API_KEY=your_nomic_api_key_here
OPENROUTER_API_KEY=                      # leave blank if unused

# ── Databases ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tim_backend
CLIENT_DATABASE_URL=postgresql://user:password@localhost:5432/tim_client
# (locally you can point both at the same DB or use sqlite for CLIENT_DATABASE_URL)

# ── Flask ──────────────────────────────────────────────
FLASK_SECRET_KEY=your_secret_key_here

# ── ChromaDB ───────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db

# ── Google OAuth (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Environment ────────────────────────────────────────
ENVIRONMENT=development
